{
  "name": "tfv-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_PUBLIC_I18N_LANGUAGES='[\"zh-HK\",\"en\"]' NEXT_PUBLIC_I18N_DEFAULT_LANGUAGE=\"zh-HK\" NEXT_PUBLIC_I18N_NAMESPACES='[\"common\"]' NEXT_PUBLIC_I18N_DEFAULT_NAMESPACE=\"common\" next dev --webpack",
    "build": "NEXT_PUBLIC_I18N_LANGUAGES='[\"zh-HK\",\"en\"]' NEXT_PUBLIC_I18N_DEFAULT_LANGUAGE=\"zh-HK\" NEXT_PUBLIC_I18N_NAMESPACES='[\"common\"]' NEXT_PUBLIC_I18N_DEFAULT_NAMESPACE=\"common\" next build --webpack",
    "build:static": "NEXT_PUBLIC_I18N_LANGUAGES='[\"zh-HK\",\"en\"]' NEXT_PUBLIC_I18N_DEFAULT_LANGUAGE=\"zh-HK\" NEXT_PUBLIC_I18N_NAMESPACES='[\"common\"]' NEXT_PUBLIC_I18N_DEFAULT_NAMESPACE=\"common\" NEXT_PUBLIC_STATIC_EXPORT=true next build --webpack",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "lucide-react": "^0.561.0",
    "next": "^16.3.4",
    "next-i18next-static-site": "^1.0.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-i18next": "^15.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5"
  }
}
